# Copy to .env and fill in. Never commit .env.

# Ring - Developer Playground token (~30 min lifetime). Regenerate when it expires.
RING_ACCESS_TOKEN=
RING_API_BASE=https://api.amazonvision.com
RING_POLL_SECONDS=5
# demo = Playground device armed per camera position; production = fixed placements
DEVICE_MODE=demo
ARM_MINUTES=10

# Postgres (docker compose up -d). Local development credentials only.
DATABASE_URL=postgresql://dealersight:dealersight@localhost:5433/dealersight

# AWS / Bedrock - uses your normal AWS credential chain (aws configure --profile dealersight)
AWS_PROFILE=dealersight
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
