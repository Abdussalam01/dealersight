# Copy to .env and fill in. Never commit .env.

# Ring - Developer Playground token (~30 min lifetime). Regenerate when it expires.
RING_ACCESS_TOKEN=
RING_API_BASE=https://api.amazonvision.com

# AWS / Bedrock - uses your normal AWS credential chain (aws configure --profile dealersight)
AWS_PROFILE=dealersight
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
