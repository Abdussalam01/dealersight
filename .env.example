# Copy to .env and fill in. Never commit .env.

# Ring - Developer Playground token (~30 min lifetime). Regenerate when it expires.
RING_ACCESS_TOKEN=
RING_API_BASE=https://api.amazonvision.com
RING_POLL_SECONDS=5
# demo = Playground device armed per camera position; production = fixed placements
DEVICE_MODE=demo
ARM_MINUTES=10

# Postgres (docker compose up -d). Local development credentials only.
DATABASE_URL=postgresql://dealersight:dealersight@localhost:5433/dealersight

# AWS / Bedrock - optional. Without credentials the analyst still answers, using the labelled
# deterministic fallback instead of Bedrock. Leave AWS_PROFILE empty to use your default
# credential chain, or set it to a named profile (aws configure --profile dealersight).
AWS_PROFILE=
AWS_REGION=us-east-1
# amazon.nova-pro-v1:0 passed validation on 24/24 benchmark calls; amazon.nova-micro-v1:0 is cheaper at ~92%.
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# Event delivery between the Ring poller and ingestion.
#   local (default) - the poller ingests directly. Needs no AWS account; use this to review.
#   sqs             - the poller publishes to Amazon SQS and a worker consumes the queue,
#                     so polling and processing are separated and a failed ingest is retried
#                     rather than lost. Requires the queue, its dead-letter queue, and the
#                     SQS statement in the IAM policy (see docs/aws.md).
EVENT_PIPELINE=local
SQS_QUEUE_URL=
SQS_DLQ_URL=
